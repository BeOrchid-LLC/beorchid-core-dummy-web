{
  "name": "@beorchid/core-dummy-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent Next.js acceptance harness for BeOrchid Core",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "workspaces": [
    "packages/core-sdk"
  ],
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build --webpack",
    "start": "next start -p 3200",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-force-exit tests/*.test.ts",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@beorchid/core-sdk": "file:packages/core-sdk",
    "@clerk/nextjs": "^6.9.6",
    "@hookform/resolvers": "^5.2.2",
    "next": "^16.3.8",
    "pg": "^8.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.65.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
