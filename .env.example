# The dummy app's own staging/local database role. Never use the migration
# credential here. This role must have access only to core_dummy_web.
DATABASE_URL=postgres://core_dummy_web_rw:replace-me@localhost:5432/beorchid_core_dev

# Clerk. The publishable key is browser-safe; the secret key is server-only.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Core. Both values are server-only. CORE_APP_KEY is fixed in src/lib/core.ts
# and is shown here as documentation only.
# CORE_API_URL=https://staging-core.example.com
# CORE_API_KEY=save-the-one-time-key-here
CORE_APP_KEY=core_dummy_web

# Core administration. All three values are server-only. CORE_ADMIN_CLERK_USER_IDS
# is a comma-separated allowlist; only those signed-in Clerk users can open or
# call the dummy app's Core onboarding console.
# CORE_ADMIN_API_KEY=replace-with-the-Core-operator-key
# CORE_APP_ID=00000000-0000-4000-8000-000000000000
# CORE_ADMIN_CLERK_USER_IDS=user_owner,user_backup_admin
